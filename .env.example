# Neon Postgres connection strings. Get both from the Neon dashboard
# (Connection Details panel has toggles for "Pooled connection" and
# "Direct connection").
#
# DATABASE_URL: pooled connection, used by the app at runtime.
# DIRECT_URL:   unpooled connection, used only for running migrations.
# Locally (no pooler), both can point at the same database.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=verify-full"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=verify-full"

# Shared password protecting /admin. Pick something long and unique.
ADMIN_PASSWORD="changeme"

# Random secret used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET="changeme"
